# Vite development proxy target (Flask backend); defaults to local server
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000

# Monad testnet RPC URL
VITE_MONAD_RPC=https://testnet-rpc.monad.xyz

# ProofWorkEscrow contract address on Monad testnet
# Set this to your deployed contract address after running forge script
VITE_CONTRACT_ADDRESS=0x

