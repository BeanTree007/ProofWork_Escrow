# Server-side configuration. Flask does not load this file automatically:
# export these in your shell (or use your process manager). Never commit real values.

# AI summary for verification reports. Without a key the report uses a template summary.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Where reports/screenshots and project briefs are stored (defaults: backend/data/reports, backend/data/briefs).
# PROOFWORK_REPORTS_DIR=
# PROOFWORK_BRIEFS_DIR=

# Lighthouse: path to the binary and Chrome flags; set INSPECTOR_SKIP_LIGHTHOUSE=1 to skip it.
# LIGHTHOUSE_BIN=
# LIGHTHOUSE_CHROME_FLAGS=--headless=new
# INSPECTOR_SKIP_LIGHTHOUSE=

# DEVELOPMENT ONLY: allow the inspector to reach localhost/private addresses.
# INSPECTOR_ALLOW_PRIVATE_HOSTS=
