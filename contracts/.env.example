MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Use fresh, testnet-only wallets. Never commit your populated .env file.
DEPLOYER_PRIVATE_KEY=0x<64-hex-characters>
REVIEW_PERIOD=604800

ESCROW_ADDRESS=0x<deployed-contract-address>
CLIENT_PRIVATE_KEY=0x<64-hex-characters>
DEVELOPER_PRIVATE_KEY=0x<64-hex-characters>
PROJECT_AMOUNT_WEI=10000000000000000
DEADLINE_OFFSET=2592000
EXTENSION_SECONDS=604800
DETAILS_HASH=0x<32-byte-requirements-hash>
WEBSITE_URL=https://example.com
